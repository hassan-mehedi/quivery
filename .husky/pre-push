echo "Running pre-push checks..."

# Run linting
echo "Running ESLint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ ESLint failed. Please fix the errors before pushing."
  exit 1
fi

# Run format check
echo "Running Prettier check..."
npm run format:check
if [ $? -ne 0 ]; then
  echo "❌ Formatting check failed. Applying formatting..."
  npm run format
  git add -A
  git commit -m "Applied prettier format"
  echo "✅ Code formatted and committed. Continuing with push..."
fi

echo "✅ All pre-push checks passed!"
