generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  todos         Todo[]
  notes         Note[]
  tags          Tag[]
  projects      Project[]
}

model Todo {
  id          String      @id @default(cuid())
  title       String
  description String?
  status      TodoStatus  @default(PENDING)
  priority    Priority    @default(MEDIUM)
  dueDate     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // New fields
  parentId    String?
  sortOrder   Int         @default(0)
  completedAt DateTime?
  projectId   String?

  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Relations
  parent      Todo?       @relation("TodoSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  subtasks    Todo[]      @relation("TodoSubtasks")
  project     Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  tags        TodoTag[]

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([parentId])
  @@index([projectId])
  // Composite indexes for common query patterns (performance optimization)
  @@index([userId, status])
  @@index([userId, priority])
  @@index([userId, status, priority])
  @@index([userId, dueDate])
  @@index([userId, projectId])
  @@index([userId, title])
  @@index([userId, sortOrder])
}

model Note {
  id          String    @id @default(cuid())
  title       String
  content     String    @db.Text
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  tags        NoteTag[]

  @@index([userId])
  // Composite indexes for common query patterns (performance optimization)
  @@index([userId, sortOrder])
  @@index([userId, title])
}

model Tag {
  id          String    @id @default(cuid())
  name        String
  color       String    @default("#8B5CF6")
  createdAt   DateTime  @default(now())

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  notes       NoteTag[]
  todos       TodoTag[]

  @@unique([name, userId])
  @@index([userId])
}

model NoteTag {
  noteId      String
  tagId       String

  note        Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  color       String    @default("#8B5CF6")
  icon        String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos       Todo[]

  @@unique([name, userId])
  @@index([userId])
}

model TodoTag {
  todoId      String
  tagId       String

  todo        Todo      @relation(fields: [todoId], references: [id], onDelete: Cascade)
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([todoId, tagId])
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
